# =============================================================================
# Root Docker Compose environment template (R29.4 / R29.5)
#
# Copy to `.env` and fill in real values before running compose:
#     cp .env.example .env
#     docker compose up --build
#
# `docker compose` interpolates every ${VAR} in docker-compose.yml from this
# file (or the shell environment). `.env` is git-ignored and holds secrets —
# NEVER commit it. All values below are non-secret placeholders.
#
# NOTE: these use Supabase's CURRENT API key names — the publishable key
# (sb_publishable_...) replaces the legacy anon key, and the secret key
# (sb_secret_...) replaces the legacy service_role key.
# =============================================================================

# --- Backend (injected as runtime env for the backend service) --------------
# Supabase project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (public) key — sb_publishable_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Supabase secret key — sb_secret_... PRIVILEGED, backend only. Supplied from
# the environment; it is never hardcoded in docker-compose.yml nor baked into
# any image layer. Replace with the real secret locally and keep it out of git.
SUPABASE_SECRET_KEY=sb_secret_your-key

# Allowed CORS origin(s), comma-separated, no trailing slash. In production
# this must not be a wildcard. Matches the frontend's published origin.
CORS_ORIGIN=http://localhost:5173

# --- Frontend (injected as build args, baked into the static bundle) --------
# Base URL of the backend API as reachable from the browser.
VITE_API_URL=http://localhost:8080

# Supabase project URL for the browser client.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (public) key — safe to bake into the frontend bundle.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Membership claims/provisioning (enable only after migration 007 rehearsal).
MEMBERSHIP_ACCESS_ENABLED=false
# Required only for claimed-mailbox replacement; backend only.
# ACCESS_EMAIL_DELIVERY_URL=https://your-mail-delivery.example/send
# ACCESS_EMAIL_DELIVERY_TOKEN=replace-with-a-secret
# PUBLIC_APP_URL=https://your-frontend.example

# Frontend build-time OTP switch and optional public Turnstile site key.
VITE_EMAIL_OTP_ENABLED=false
VITE_AUTH_CAPTCHA_SITE_KEY=

# Enable only after migration 008 and member view acceptance checks.
MEMBER_VIEWS_ENABLED=false

# Keep signup disabled until provider configuration, commercial terms and billing acceptance are complete.
SELF_SERVICE_SIGNUP_ENABLED=false
BILLING_AVAILABLE=false

# Stripe hosted subscriptions. Secrets are backend-only. No price/cap is invented.
CHECKOUT_ENABLED=false
STRIPE_MODE=TEST
# TEST keys must begin sk_test_; LIVE requires a separate approved rollout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ACCOUNT_ID=
STRIPE_MERCHANT_COUNTRY=
STRIPE_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
BILLING_PLAN_TITLE=
BILLING_PLAN_FEATURES=
BILLING_MEMBER_LIMIT=
BILLING_CURRENCY=
BILLING_TAX_BEHAVIOR=
BILLING_AUTOMATIC_TAX=
BILLING_PAYMENT_METHODS=
BILLING_TERMS_URL=
BILLING_PRIVACY_URL=
BILLING_POLICY_URL=
BILLING_TAX_DISCLOSURE=
BILLING_APPROVAL_REFERENCE=
BILLING_EVENT_RETENTION_DAYS=
BILLING_MAX_RETRIES=10
# Features: pipe-separated. Member limit: positive integer or explicit unlimited.
# Tax behavior: inclusive/exclusive; automatic tax: true/false; MVP methods: card.
# PUBLIC_APP_URL must be an origin; HTTPS except localhost in development.

# Entitlement policy: durations deliberately have no production defaults.
ENTITLEMENT_ENFORCEMENT_ENABLED=false
ENTITLEMENT_TRIALS_ENABLED=false
ENTITLEMENT_POLICY_VERSION=
ENTITLEMENT_POLICY_APPROVAL=
RENEWAL_GRACE_DAYS=
PROVIDER_OUTAGE_TOLERANCE_HOURS=
LEGACY_ENTITLEMENT_DEADLINE=
# Explicit approved exception handling: RESTRICT.
ENTITLEMENT_EXCEPTION_POLICY=
# Publish a complete approved policy from the worker before enabling checkout.
# Existing legacy cohorts are enrolled explicitly; login/migration never charges.
