# =============================================================================
# Backend environment template (R29.6)
#
# Copy to `.env` and fill in real values for local development:
#     cp .env.example .env
#
# `.env` is git-ignored and is NEVER baked into a Docker image (see
# .dockerignore). In production these are injected by docker-compose from the
# host environment / root .env. Values below are non-secret placeholders only.
# =============================================================================

# Port the Fastify server binds to (0.0.0.0:PORT). Defaults to 8080.
PORT=8080

# Runtime mode: development | test | production.
# In production, CORS is restricted to CORS_ORIGIN (no wildcard — R29.8).
NODE_ENV=development

# Supabase project URL, e.g. https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase PUBLISHABLE key (sb_publishable_...). The current public client key
# that replaces the legacy anon key; used for user-scoped requests. Safe to
# expose. (Legacy name: SUPABASE_ANON_KEY.)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Supabase SECRET key (sb_secret_...). The current privileged key that replaces
# the legacy service_role key; used for atomic ledger writes. Backend only —
# NEVER expose to the frontend and NEVER commit a real value.
# (Legacy name: SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=sb_secret_your-key

# OPTIONAL: override the JWKS endpoint used to verify user JWTs. When unset the
# backend derives it from SUPABASE_URL:
#   ${SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Only set this to point verification at a non-default JWKS location.
# SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Comma-separated list of allowed CORS origins (no trailing slash).
# Example for local dev with the Vite dev server + compose frontend:
CORS_ORIGIN=http://localhost:5173

# Membership claims and provisioning are disabled until migration 007 is rehearsed.
MEMBERSHIP_ACCESS_ENABLED=false
# Required only for replacing an already claimed membership's login mailbox.
# Delivery endpoint accepts authenticated JSON POSTs; see membership rollout guide.
# ACCESS_EMAIL_DELIVERY_URL=https://your-mail-delivery.example/send
# ACCESS_EMAIL_DELIVERY_TOKEN=replace-with-a-secret
# PUBLIC_APP_URL=https://your-frontend.example

# Enable only after migration 008 and member view acceptance checks.
MEMBER_VIEWS_ENABLED=false
