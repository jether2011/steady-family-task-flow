{
  "name": "family-task-board-backend",
  "version": "0.1.0",
  "description": "Family Task Board backend \u2014 Fastify + TypeScript over Supabase",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "worker": "node --env-file-if-exists=.env dist/billing-worker.js",
    "worker:dev": "tsx --env-file-if-exists=.env src/billing-worker.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "@supabase/supabase-js": "2.117.3",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "jose": "6.2.12",
    "pino": "10.4.0",
    "stripe": "23.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "fast-check": "4.10.2",
    "pg": "^8.23.1",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
