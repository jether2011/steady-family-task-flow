# Public build-time frontend configuration. Never put service-role secrets here.
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Enable after SMTP, six-digit email template and provider controls are verified.
VITE_EMAIL_OTP_ENABLED=false
# Optional public Turnstile site key; configure its secret in Supabase.
VITE_AUTH_CAPTCHA_SITE_KEY=
